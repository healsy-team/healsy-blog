---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import Ambient from '../../components/Ambient.astro';
import { SITE_DESCRIPTION } from '../../consts';

const rawPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const posts = await Promise.all(
	rawPosts.map(async (post) => {
		let profile: { login: string; avatar: string } | null = null;
		const gh = post.data.authorGithub;
		if (gh) {
			try {
				const res = await fetch(`https://api.github.com/users/${gh}`, {
					headers: { 'User-Agent': 'healsy-blog', Accept: 'application/vnd.github+json' },
				});
				if (!res.ok) throw new Error(`${res.status}`);
				const d = await res.json();
				profile = { login: d.login, avatar: d.avatar_url };
			} catch {
				profile = { login: gh, avatar: `https://github.com/${gh}.png` };
			}
		}
		return { post, profile };
	}),
);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title="Blog" description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Ambient />
		<Header />
		<main>
			<header class="page-head">
				<p class="kicker">JOURNAL</p>
				<h1>기술 저널</h1>
				<p class="sub">깔창 회사가 AI 와 소프트웨어로 문제를 풀어가는 기록.</p>
			</header>

			<ul class="articles">
				{
					posts.map(({ post, profile }, i) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<span class="num">{String(i + 1).padStart(2, '0')}</span>
								<div class="body">
									<h2>{post.data.title}</h2>
									<div class="meta">
										<FormattedDate date={post.data.pubDate} />
										{profile && (
											<>
												<span class="dot" aria-hidden="true">·</span>
												<span class="author">
													<img src={profile.avatar} alt={profile.login} width="18" height="18" loading="lazy" />
													{profile.login}
												</span>
											</>
										)}
										{post.data.author && (
											<>
												<span class="dot" aria-hidden="true">·</span>
												<span>{post.data.author}</span>
											</>
										)}
									</div>
								</div>
								<span class="arrow" aria-hidden="true">&rarr;</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-head {
		padding: 2.5em 0 1em;
	}
	.kicker {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.22em;
		color: var(--accent);
		margin: 0 0 0.6em;
	}
	.page-head h1 {
		font-size: 3em;
		margin: 0 0 0.3em;
	}
	.page-head .sub {
		color: rgb(var(--gray));
		font-size: 1.05em;
		margin: 0;
	}
	.articles {
		list-style: none;
		margin: 2.5em 0 0;
		padding: 0;
	}
	.articles li {
		border-top: 1px solid var(--outline);
	}
	.articles li:last-child {
		border-bottom: 1px solid var(--outline);
	}
	.articles li a {
		display: flex;
		align-items: baseline;
		gap: 1.4em;
		padding: 2.2em 0.5em 2.2em 0;
		text-decoration: none;
		transition: padding 0.2s ease;
	}
	.articles li a:hover {
		padding-left: 0.5em;
	}
	.num {
		font-family: var(--font-mono);
		font-size: 1rem;
		color: var(--accent);
		opacity: 0.7;
		min-width: 2.2em;
		flex-shrink: 0;
	}
	.body {
		flex: 1;
		min-width: 0;
	}
	.articles h2 {
		font-size: 2em;
		line-height: 1.2;
		margin: 0 0 0.5em;
		color: rgb(var(--black));
		transition: color 0.15s ease;
	}
	.articles li a:hover h2 {
		color: var(--brand);
	}
	.meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5em;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: rgb(var(--gray));
	}
	.meta .author {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
	}
	.meta .author img {
		width: 18px;
		height: 18px;
		border-radius: 50%;
		border: 1px solid var(--outline);
	}
	.meta .dot {
		opacity: 0.5;
	}
	.arrow {
		align-self: center;
		font-size: 1.3rem;
		color: rgb(var(--gray));
		opacity: 0;
		transform: translateX(-8px);
		transition:
			opacity 0.2s ease,
			transform 0.2s ease;
		flex-shrink: 0;
	}
	.articles li a:hover .arrow {
		opacity: 1;
		transform: translateX(0);
		color: var(--brand);
	}
	@media (max-width: 720px) {
		.page-head h1 {
			font-size: 2.2em;
		}
		.articles h2 {
			font-size: 1.5em;
		}
		.arrow {
			display: none;
		}
	}
</style>
